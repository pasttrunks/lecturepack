    {
      "id": "planning_milestones_v0_9_0_beta_6_phases_04_visual_artifact_reliability_04_research_css_spotlight",
      "label": "QtWebEngine-safe CSS spotlight (Phase 3)",
      "file_type": "rationale",
      "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\.planning\\milestones\\v0.9.0-beta.6\\phases\\04-visual-artifact-reliability\\04-RESEARCH.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Reuse the existing CSS box-shadow spotlight with a pointer-transparent overlay and real controls instead of a full-viewport SVG mask or synthetic hit layer to preserve QtWebEngine hit-test behavior."
    },
    {
      "id": "planning_milestones_v0_9_0_beta_6_phases_04_visual_artifact_reliability_04_research_rAF_coalesced_geometry",
      "label": "requestAnimationFrame-coalesced geometry scheduler",
      "file_type": "rationale",
      "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\.planning\\milestones\\v0.9.0-beta.6\\phases\\04-visual-artifact-reliability\\04-RESEARCH.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Deduplicate resize/scroll/visual-viewport/observer events into one requestAnimationFrame callback that minimally reveals the target, remeasures live rects, and clamps spotlight/card/tooltip using actual viewport dimensions."
    },
    {
      "id": "planning_milestones_v0_9_0_beta_6_phases_04_visual_artifact_reliability_04_research_tooltip_controller",
