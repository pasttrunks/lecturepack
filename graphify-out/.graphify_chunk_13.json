    {
      "id": "planning_milestones_v0_9_0_beta_6_phases_04_visual_artifact_reliability_04_context_navigation_only_entrance",
      "label": "Navigation-only entrance animation (D-01..D-04)",
      "file_type": "rationale",
      "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\.planning\\milestones\\v0.9.0-beta.6\\phases\\04-visual-artifact-reliability\\04-CONTEXT.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Entrance animation must run only after a real user navigation to a different page; backend events, option changes, state rendering, active-nav re-click, and overlay closure must never replay or jump the page."
    },
    {
      "id": "planning_milestones_v0_9_0_beta_6_phases_04_visual_artifact_reliability_04_context_atomic_theme_transaction",
      "label": "Atomic theme initialization and switching (D-05..D-09)",
      "file_type": "rationale",
      "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\.planning\\milestones\\v0.9.0-beta.6\\phases\\04-visual-artifact-reliability\\04-CONTEXT.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Fresh profile defaults to Light; saved theme applies before the first visible frame; user toggle swaps the whole palette atomically with immediate one-value persistence, no crossfade or per-element color tween."
    },
    {
      "id": "planning_milestones_v0_9_0_beta_6_phases_04_visual_artifact_reliability_04_context_long_value_tooltip",
      "label": "Long model value tooltip and responsive layout (D-10..D-12)",
      "file_type": "rationale",
      "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\.planning\\milestones\\v0.9.0-beta.6\\phases\\04-visual-artifact-reliability\\04-CONTEXT.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Long local-model names stay on one line with ellipsis released via hover/focus tooltip; narrow layouts stack controls with vertical scrolling, and Phase 4 imposes no minimum window size."
    },
    {
      "id": "planning_milestones_v0_9_0_beta_6_phases_04_visual_artifact_reliability_04_context_tour_geometry_focus",
      "label": "Tour/gate resize, DPI, and focus reliability (D-13..D-16)",
      "file_type": "rationale",
      "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\.planning\\milestones\\v0.9.0-beta.6\\phases\\04-visual-artifact-reliability\\04-CONTEXT.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Tour spotlight continuously tracks the real target and clamps the card to the viewport on resize/scroll/DPI changes with minimal reveal scroll; runtime setup gate stays modal with scoped focus and always-reachable Exit."
    },
    {
      "id": "planning_milestones_v0_9_0_beta_6_phases_04_visual_artifact_reliability_04_context_locked_visual_preservation",
      "label": "Locked beta-5 visual preservation contract (D-17, D-18)",
      "file_type": "rationale",
      "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\.planning\\milestones\\v0.9.0-beta.6\\phases\\04-visual-artifact-reliability\\04-CONTEXT.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Preserve beta-5 animation timings, transitions, hard dark shadows, press/embedded control movement, palette, typography, and motion character; do not use a full-viewport SVG mask for spotlights, retaining the QtWebEngine-safe CSS spotlight."
    },
    {
