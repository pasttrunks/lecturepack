      "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\.planning\\milestones\\v0.9.0-beta.6\\phases\\04-visual-artifact-reliability\\04-RESEARCH.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Give each truncated model display stable tabindex, aria-describedby, and one shared tooltip element; show exact textContent on hover/focus and hide on leave/blur, clamped inside the viewport without resizing or reflowing the source field."
