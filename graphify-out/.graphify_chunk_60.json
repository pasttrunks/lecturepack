    },
    {
      "id": "electron_spike_deepseek_electron_beta15_combined_audit_report_noopcalls_epidemic",
      "label": "noopCalls Epidemic (electron-bridge.js)",
      "file_type": "concept",
      "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\electron-spike\\deepseek\\ELECTRON_BETA15_COMBINED_AUDIT_REPORT.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Largest defect cluster: every command in noopCalls resolves to null, so the UI renders the button, the click fires, the promise resolves to null, and nothing happens — root cause of D-2,D-3,D-6,D-7,D-10,D-14,D-15."
    },
    {
      "id": "electron_spike_deepseek_electron_beta15_combined_audit_report_feature_unavailable_pattern",
      "label": "FEATURE_UNAVAILABLE Response Pattern",
      "file_type": "rationale",
      "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\electron-spike\\deepseek\\ELECTRON_BETA15_COMBINED_AUDIT_REPORT.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Route every deferred control to a structured FEATURE_UNAVAILABLE response with a human-readable message (unavailableMessages) instead of a silent null."
    },
    {
      "id": "electron_spike_deepseek_electron_dist_frustrated_student_audit_r2_guard_and_translate_layer",
      "label": "Guard-and-Translate Layer",
      "file_type": "rationale",
      "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\electron-spike\\deepseek\\ELECTRON_DIST_FRUSTRATED_STUDENT_AUDIT_R2.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Disable controls invalid in the current state, and translate every backend/IPC rejection into friendly copy before it reaches a toast — clears N-1,N-2,N-4,N-6 in one stroke."
    },
    {
      "id": "electron_spike_deepseek_electron_beta15_combined_audit_report_overlay_manager",
      "label": "Overlay / z-index Manager",
