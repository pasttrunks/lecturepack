    {"id": "docs_evidence_v1_2_0_groq_backends_readme_log_redaction", "label": "Log Redaction", "file_type": "concept", "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\docs\\evidence\\v1.2.0\\groq_backends\\README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Log manager scans and redacts authorization headers, request bodies, and keys so secrets never leak into logs"},
    {"id": "docs_evidence_v1_2_0_groq_backends_readme_opt_in_online_mode", "label": "Opt-in Online Mode (Per-Job Consent)", "file_type": "rationale", "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\docs\\evidence\\v1.2.0\\groq_backends\\README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Online mode is disabled by default and requires explicit per-job consent, keeping user-media privacy the default posture"},
