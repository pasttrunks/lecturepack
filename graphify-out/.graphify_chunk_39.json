    {"id": "docs_evidence_v1_2_0_groq_backends_readme_size_aware_chunking", "label": "Size-Aware Overlapping Chunking", "file_type": "rationale", "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\docs\\evidence\\v1.2.0\\groq_backends\\README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Groq imposes a 25 MB free-tier upload limit, so LecturePack caps chunks at a conservative 23 MiB and prepares compressed FLAC audio locally to reduce payload size; overlap keeps segment continuity"},
    {"id": "docs_evidence_v1_2_0_groq_backends_readme_rate_limit_backoff", "label": "Rate-Limit Backoff (HTTP 429)", "file_type": "rationale", "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\docs\\evidence\\v1.2.0\\groq_backends\\README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Robust error recovery: rate-limiting (HTTP 429) backoff obeys the Retry-After header so the client throttles respectfully"},
    {"id": "docs_evidence_v1_2_0_groq_backends_readme_local_fallback", "label": "Private Local Fallback", "file_type": "concept", "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\docs\\evidence\\v1.2.0\\groq_backends\\README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Provider errors (quota-exhausted, connection-refused, malformed responses) automatically fall back to the Private Local backend so transcription never hard-fails"},
