    {
      "id": "docs_evidence_v1_2_0_groq_live_validation_readme_privacy_consent",
      "label": "Per-Job Privacy Consent Dialog",
      "file_type": "rationale",
      "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\docs\\evidence\\v1.2.0\\groq_live_validation\\README.md",
