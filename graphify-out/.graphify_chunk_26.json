    {"id": "app_ui_index_subject_grouping", "label": "Subject Grouping", "file_type": "concept", "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\app\\ui\\index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "app_ui_index_progressive_unlocking", "label": "Progressive Subject Unlocking", "file_type": "rationale", "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\app\\ui\\index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Group study covers already-ready lectures now and updates automatically when remaining lectures in a subject finish; a banner surfaces how many of the subject's lectures are ready."},
    {"id": "app_ui_index_smart_study", "label": "Smart Study (Local AI)", "file_type": "concept", "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\app\\ui\\index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optional private local AI (Ollama) for better quizzes, flashcards, and lecture chat; Built-in Study always works without it. No account or subscription required."},
    {"id": "app_ui_index_study_assistant", "label": "Study Assistant", "file_type": "code", "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\app\\ui\\index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "app_ui_index_study_pack", "label": "Study Pack", "file_type": "concept", "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\app\\ui\\index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A lecture recording turned into a grounded study workspace: key concepts, flashcards and a quiz built from this lecture, not the internet."},
    {"id": "app_ui_index_whispercpp", "label": "whisper.cpp Transcription (Private Local)", "file_type": "concept", "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\app\\ui\\index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Private Local transcription runs on the user's machine; the default engine is whisper.cpp with a base.en model."},
    {"id": "app_ui_index_groq_transcription", "label": "Groq Online Transcription", "file_type": "concept", "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\app\\ui\\index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Online modes upload audio (only) to Groq and require an API key; offered as Online Fast and Online Accurate alternatives to Private Local."},
    {"id": "app_ui_index_ollama", "label": "Ollama Local AI Engine", "file_type": "concept", "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\app\\ui\\index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Smart Study needs the free Local AI Engine (Ollama), default endpoint http://localhost:11434, with user-selectable installed models."},
    {"id": "app_ui_index_light_dark_theme", "label": "Light/Dark Theme", "file_type": "concept", "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\app\\ui\\index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "app_ui_index_study_tab_design", "label": "Study Mode Tab Design Language", "file_type": "rationale", "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\app\\ui\\index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Study mode tabs use the same control vocabulary as every other button (rounded corners, 2px border, resting hard shadow, hover lift, press into surface). They were previously flat underline tabs (square, no border/shadow/press), making this the one control row that looked like plain text."},
    {"id": "app_ui_index_archive_restore_removed", "label": "Removed Archive/Restore Placeholders", "file_type": "rationale", "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\app\\ui\\index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Archive/Restore lived on as permanently-disabled placeholders whose tooltips still said 'not available in Beta 15' three releases later. With no handler, sidecar command, or feature behind them they only taught students that two of four controls do nothing, so they were removed rather than re-labelled; they can return with the feature."},
    {"id": "app_ui_index_compact_roomy_removed", "label": "Removed Compact/Roomy Slide Toggle", "file_type": "rationale", "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\app\\ui\\index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Compact/Roomy toggle was removed because the two modes differed by a 22px thumbnail and a 1px font, so the control did not visibly change density and neither size was readable. One adaptive layout replaces it: the slide rail fits two columns when wide enough for two legible 16:9 thumbnails and one when it is not."},
    {"id": "app_ui_index_storage_widget_fix", "label": "Storage Widget Driven by Backend Signal", "file_type": "rationale", "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\app\\ui\\index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The storage widget stays hidden until the backend reports real disk usage via the job_storage signal. It previously shipped a hardcoded '340 MB' that no code ever updated."},
    {"id": "app_ui_index_queue_lib_grid", "label": "Home Queue Uses Adaptive Grid", "file_type": "rationale", "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\app\\ui\\index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The processing queue is an auto-filling grid (.lib-grid), not one row per job; an inline flex column used to override the stylesheet."},
    {"id": "app_ui_index_local_privacy", "label": "Local Processing & Privacy By Design", "file_type": "rationale", "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\app\\ui\\index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lecture processing runs on the user's machine, no video or audio upload, no account. Study AI only sends selected transcript and accepted-slide evidence through the gateway plus anonymous service-health metadata; job data stays in the user's chosen LecturePack data folder."},
    {"id": "app_ui_index_export_formats", "label": "Export Formats", "file_type": "concept", "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\app\\ui\\index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}
