    {"id":"_planning_intel_synthesis_seven_stage_pipeline","label":"7-Stage Pipeline","file_type":"concept","source_file":"C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\.planning\\intel\\SYNTHESIS.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},
    {"id":"_planning_intel_synthesis_local_first_model","label":"Local-First Model (No Cloud by Default)","file_type":"rationale","source_file":"C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\.planning\\intel\\SYNTHESIS.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Personal university lecture workflow, not commercial; no telemetry, accounts, databases, or cloud by default keeps data local and avoids infrastructure."},
    {"id":"_planning_intel_decisions_ad1_qprocess_qthread","label":"AD-1 QProcess + QThreading Model","file_type":"rationale","source_file":"C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\.planning\\intel\\decisions.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"External CLIs must not block the UI event loop, so QProcess integrates them and QThread workers isolate CPU-heavy Python work."},
    {"id":"_planning_intel_decisions_ad2_state_machine_atomic_writes","label":"AD-2 Per-Stage State Machine with Atomic Writes","file_type":"rationale","source_file":"C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\.planning\\intel\\decisions.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Crash recovery: atomic state.json writes plus resume guarantee no half-written jobs are lost on interruption."},
    {"id":"_planning_intel_decisions_ad3_plain_files_json","label":"AD-3 Plain Files and JSON Manifests (No Database)","file_type":"rationale","source_file":"C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\.planning\\intel\\decisions.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Local-first, no server; per-job plain files are simpler, inspectable, and portable versus an embedded database."},
    {"id":"_planning_intel_decisions_ad4_app_relative_binary_paths","label":"AD-4 Application-Relative Binary Paths","file_type":"rationale","source_file":"C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\.planning\\intel\\decisions.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Bundled binaries must resolve identically under PyInstaller and dev, so paths are app-relative and never system PATH."},
    {"id":"_planning_intel_decisions_ad5_deterministic_cv_pipeline","label":"AD-5 Deterministic CV Pipeline (No LLM)","file_type":"rationale","source_file":"C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\.planning\\intel\\decisions.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Slide detection must be reproducible and offline-safe; a tiered CV cascade avoids LLM cost, latency, and non-determinism."},
    {"id":"_planning_intel_decisions_ad6_reportlab_img2pdf","label":"AD-6 ReportLab + img2pdf for PDFs","file_type":"rationale","source_file":"C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\.planning\\intel\\decisions.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"img2pdf gives lossless slide-only PDFs; ReportLab's Platypus layout engine handles mixed image+text study packs."},
    {"id":"_planning_intel_decisions_ad7_self_contained_html","label":"AD-7 Self-Contained HTML with Base64 Images","file_type":"rationale","source_file":"C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\.planning\\intel\\decisions.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Single self-contained HTML works offline; timestamp links open the source video in the default player."},
    {"id":"_planning_intel_decisions_ad8_pyinstaller_nuitka","label":"AD-8 PyInstaller over Nuitka","file_type":"rationale","source_file":"C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\.planning\\intel\\decisions.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"PyInstaller chosen first for initial Windows packaging; Nuitka left as a future optimization."},
    {"id":"_planning_intel_decisions_ad9_adaptive_baseline_two_path","label":"AD-9 Adaptive Baseline + Two-Path Slide Detection (v0.4)","file_type":"rationale","source_file":"C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\.planning\\intel\\decisions.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Single-threshold cascade missed small persistent additions; two explicit paths (rolling baseline + contour analysis) handle both major and progressive slide changes."},
    {"id":"_planning_intel_decisions_ad10_nonblocking_ui_shutdown","label":"AD-10 Non-Blocking UI Shutdown + PID-Scoped Process Trees (v1.2)","file_type":"rationale","source_file":"C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\.planning\\intel\\decisions.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Stability on Windows requires immediate, non-blocking close and killing only the external-tool process tree by exact root PID."},
    {"id":"_planning_intel_decisions_ad11_study_data_separation","label":"AD-11 Separate User Study Data from Source Artifacts (v1.2)","file_type":"rationale","source_file":"C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\.planning\\intel\\decisions.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"User-authored study state must not be confused with deterministic source-derived artifacts; provenance is labelled in the UI."},
    {"id":"_planning_intel_decisions_ad12_provider_neutral_transcription","label":"AD-12 Provider-Neutral Transcription Seam (v1.2)","file_type":"rationale","source_file":"C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\.planning\\intel\\decisions.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"A service-layer TranscriptionBackend contract lets providers (local or cloud) plug in without coupling the UI to any one engine; fails closed to Private Local."},
    {"id":"_planning_intel_decisions_ad13_opt_in_groq","label":"AD-13 Opt-In Groq Transcription with Credential Manager (v1.2)","file_type":"rationale","source_file":"C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\.planning\\intel\\decisions.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Online transcription is strictly opt-in per job, key read from Windows Credential Manager, only lossless FLAC uploaded, Private Local remains default."},
