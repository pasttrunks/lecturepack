    {
      "id": "_planning_phases_01_clean_device_footprint_first_launch_01_research_opengl32sw_retention",
      "label": "opengl32sw.dll software GL fallback",
      "file_type": "rationale",
      "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\.planning\\phases\\01-clean-device-footprint-first-launch\\01-RESEARCH.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "D-02 locks opengl32sw.dll in the tree: the software GL fallback is what keeps the app working on VMs and old GPUs, exactly the clean-device population this phase serves. Not in the cut scope."
    },
    {
      "id": "_planning_phases_01_clean_device_footprint_first_launch_01_research_setup_acknowledged",
      "label": "setup_acknowledged persistence flag",
      "file_type": "concept",
      "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\.planning\\phases\\01-clean-device-footprint-first-launch\\01-RESEARCH.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "D-16: setup_acknowledged persists alongside runtime_health in config.json, not WebEngine localStorage (which dies with the WebEngine profile, like the guided-tour flag). Persisted in ConfigManager."
    },
    {
      "id": "_planning_phases_01_clean_device_footprint_first_launch_01_research_debug_pak_resources",
      "label": "qtwebengine_devtools .debug.* resource dead weight",
      "file_type": "concept",
      "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\.planning\\phases\\01-clean-device-footprint-first-launch\\01-RESEARCH.md",
