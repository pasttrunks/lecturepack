    {
      "id": "docs_evidence_v1_2_0_webview_functionality_recovery_dark_theme_readme_dark_theme_secondary_palette",
      "label": "Dark-theme secondary palette (\u00a710)",
      "file_type": "concept",
      "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\docs\\evidence\\v1.2.0\\webview_functionality_recovery\\dark_theme\\README.md",
      "source_location": "\u00a710 Dark-theme secondary palette",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Dark mode previously used large bright-cyan filled controls with white text, which was jarring and had poor contrast. These were fixed to deep-blue/navy surfaces with cyan text/border per the design spec, so dark-mode controls read clearly without harsh bright fills."
    },
    {
      "id": "docs_evidence_v1_2_0_webview_functionality_recovery_dark_theme_readme_secondary_tokens",
      "label": "--secondary-* palette tokens",
      "file_type": "concept",
      "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\docs\\evidence\\v1.2.0\\webview_functionality_recovery\\dark_theme\\README.md",
      "source_location": "## Tokens (app/ui/app.css)",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Added in both themes. Dark values are spec-exact (surface #12303F family); light derives a light-cyan surface (#DDF5F9) with ink text (#0C6675). Tokens keep the palette consistent and themeable without hard-coded colors."
    },
