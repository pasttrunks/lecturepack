    {
      "id": "docs_evidence_mvp_walkthrough_detection_presets_tuning",
      "label": "Detection Presets Tuning",
      "file_type": "rationale",
      "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\docs\\evidence\\mvp\\walkthrough.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "dhash_reject lowered to 2 to prevent early rejection of subtle progressive builds at Stage 1; ssim_reject raised to 0.98 to let progressive updates proceed to Stage 3; hist_bhatt_accept lowered to 0.04 and pixel_diff_accept lowered to 0.008 to identify small additions."
    },
    {
      "id": "docs_evidence_mvp_walkthrough_stage_3_evaluation",
      "label": "Stage 3 Evaluation Optimization (AND to OR)",
      "file_type": "rationale",
      "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\docs\\evidence\\mvp\\walkthrough.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Stage 3 confirmation logic changed from AND to OR for Bhattacharyya distance and pixel difference ratio so that small progressive whiteboard handwriting or text bullet updates trigger slide transitions."
    },
    {
      "id": "docs_evidence_mvp_walkthrough_deduplication_guard",
      "label": "Deduplication Guard (SSIM >= 0.95)",
      "file_type": "rationale",
      "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\docs\\evidence\\mvp\\walkthrough.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "An SSIM similarity check (requiring >= 0.95 similarity) integrated inside the local deduplication loop prevents false positive collapsing of visually distinct slides with flat backgrounds."
    },
