{
  "nodes": [
    {"id": "ai_gateway_admin_dashboard", "label": "LecturePack Gateway Admin Dashboard", "file_type": "document", "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\ai-gateway\\admin\\dashboard.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A standalone HTML admin dashboard (SaaS-era viewer) for the LecturePack AI Gateway. It is designed to be opened directly (works from file:// by defaulting to the production Workers URL) and talks to a backend /v1/admin/stats endpoint, keeping runtime dependencies minimal."},
    {"id": "ai_gateway_admin_dashboard_usage_viewer", "label": "Model Usage Viewer", "file_type": "concept", "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\ai-gateway\\admin\\dashboard.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Primary purpose of the page (per its <title>): view model usage. The design favors at-a-glance observability over editing, presenting aggregate metrics, per-model/task breakouts, and route health."},
    {"id": "ai_gateway_admin_dashboard_admin_key_auth", "label": "Admin API Key Authentication", "file_type": "rationale", "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\ai-gateway\\admin\\dashboard.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Auth is done by the user entering the ADMIN_API_KEY secret in a password input. It is sent to the backend as both a Bearer token and an x-admin-key header; on 401/403 the UI shows an explicit 'Unauthorized (Check Key)' state. Key and gateway URL are prefillable via ?key= / ?url= query or hash params."},
    {"id": "ai_gateway_admin_dashboard_usage_stats", "label": "Usage Statistics Data Model", "file_type": "concept", "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\ai-gateway\\admin\\dashboard.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The backend response contract the dashboard renders: { summary, models[], tasks[], health[], recent_events[], openrouter_balance }. Summary holds total/successful/failed calls, input/output tokens and avg latency. This shared data shape couples the dashboard to the /v1/admin/stats endpoint response."},
    {"id": "ai_gateway_admin_dashboard_models_breakdown", "label": "Provider & Model Usage Breakdown", "file_type": "concept", "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\ai-gateway\\admin\\dashboard.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Main table columns provider/model: total calls, success rate (with red<95%/green progress bar), input/output tokens, avg latency. Renders empty state until data is fetched."},
    {"id": "ai_gateway_admin_dashboard_task_breakdown", "label": "Usage by Study Task", "file_type": "concept", "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\ai-gateway\\admin\\dashboard.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Second table aggregates usage by study/task type (task type, calls, success rate, avg latency), letting operators see which study workloads drive spend."},
    {"id": "ai_gateway_admin_dashboard_route_health", "label": "Route Health & Cooldown Status", "file_type": "concept", "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\ai-gateway\\admin\\dashboard.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-route view of consecutive_failures and last_error_code. The UI derives cooldown state client-side: >=2 consecutive fails shows 'Cooling Down', 1 fail shows '1 Failure', 0 shows 'Healthy'. This surfaces the gateway's circuit-breaker/cooldown behavior."},
    {"id": "ai_gateway_admin_dashboard_operational_events", "label": "Recent Operational Events Feed", "file_type": "concept", "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\ai-gateway\\admin\\dashboard.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Feed of the last 50 events ('Metadata Only' badge) showing time, task, provider/model, HTTP status, latency and tokens in/out, for operational audit and debugging failed requests."},
    {"id": "ai_gateway_admin_dashboard_openrouter_balance", "label": "OpenRouter Balance Display", "file_type": "concept", "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\ai-gateway\\admin\\dashboard.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shows live OpenRouter account credits (limit_remaining / usage / cap). Distinct states for balanced data vs. error (check OPENROUTER_API_KEY) vs. no key configured, reflecting env-driven availability."},
    {"id": "ai_gateway_admin_dashboard_time_windows", "label": "Time Window Selection", "file_type": "concept", "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\ai-gateway\\admin\\dashboard.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Operator picks a report window (24h/7d/30d/All) which is sent as ?window= to the stats endpoint and re-fetches on change, letting the same data shape be queried over different ranges."},
    {"id": "ai_gateway_admin_dashboard_live_polling", "label": "Live Background Polling", "file_type": "rationale", "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\ai-gateway\\admin\\dashboard.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses a 10s setInterval to silently re-fetch usage data, but only when a key is set and the document is visible (document.hidden check) to avoid wasted background requests. This keeps the dashboard live without a websocket."},
    {"id": "ai_gateway_admin_dashboard_theme_toggle", "label": "Dark/Light Theme Toggle", "file_type": "rationale", "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\ai-gateway\\admin\\dashboard.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A button toggles dark/light mode via data-theme attribute and CSS custom properties, persisted to localStorage (default dark). Design language uses a 'hard shadow' neo-brutalist aesthetic with Space Grotesk / JetBrains Mono fonts."},
    {"id": "ai_gateway_admin_dashboard_local_storage", "label": "localStorage Credential & Pref Persistence", "file_type": "rationale", "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\ai-gateway\\admin\\dashboard.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Admin key, gateway URL and theme are remembered in localStorage (lp_admin_gateway_key / lp_admin_gateway_url / lp_admin_theme) so an operator does not re-enter them on every reload; URL/hash params take precedence on load."},
    {"id": "ai_gateway_admin_dashboard_provider_badges", "label": "Provider Badge System", "file_type": "concept", "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\ai-gateway\\admin\\dashboard.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Visual provider identification: NVIDIA, OpenRouter, Workers AI, and Google AI each get a distinct colored badge (matched by substring on provider name), reused across the models table and the events feed."},
    {"id": "ai_gateway_admin_dashboard_admin_stats_endpoint", "label": "/v1/admin/stats Endpoint", "file_type": "concept", "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\ai-gateway\\admin\\dashboard.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The only backend dependency: a GET /v1/admin/stats?window=... call authenticated with the admin key. The default production host is https://lecturepack-ai-gateway.discordsammy2.workers.dev."},
    {"id": "ai_gateway_admin_dashboard_connection_status", "label": "Connection Status Indicator", "file_type": "concept", "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\ai-gateway\\admin\\dashboard.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Header shows a pulsing status dot + text with states: Ready, Enter Key, Fetching..., Connected, Unauthorized (Check Key), and Error, giving immediate feedback on auth and connectivity."}
  ],
