    {"id": "_planning_milestones_v0_9_0_beta_6_phases_01_runtime_contract_bootstrap_01_context_required_admission_set", "label": "D-01 Required Runtime Admission Set", "file_type": "concept", "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\.planning\\milestones\\v0.9.0-beta.6\\phases\\01-runtime-contract-bootstrap\\01-CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optional engines (CUDA, Vulkan, Ollama, Groq, yt-dlp) never determine core admission health; bundled CPU is the guaranteed recovery path."},
    {"id": "_planning_milestones_v0_9_0_beta_6_phases_01_runtime_contract_bootstrap_01_patterns_runtime_inventory", "label": "Canonical Runtime Inventory", "file_type": "concept", "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\.planning\\milestones\\v0.9.0-beta.6\\phases\\01-runtime-contract-bootstrap\\01-PATTERNS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One code-owned ordered inventory (ffmpeg/ffprobe/whisper-cli/DLLs/base model/smoke WAV) consumed by startup, diagnostics, packaging, repair, and tests to prevent drifting duplicate file lists."},
    {"id": "_planning_milestones_v0_9_0_beta_6_phases_01_runtime_contract_bootstrap_01_context_persist_complete_facts", "label": "Persist Only Complete Validated Facts", "file_type": "rationale", "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\.planning\\milestones\\v0.9.0-beta.6\\phases\\01-runtime-contract-bootstrap\\01-CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fresh/stale/partial/invalid saved runtime paths must never become a healthy state, so health persistence is one atomic complete snapshot."},
    {"id": "_planning_milestones_v0_9_0_beta_6_phases_01_runtime_contract_bootstrap_01_context_light_full_validation", "label": "Light/Full Validation Policy (D-04)", "file_type": "concept", "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\.planning\\milestones\\v0.9.0-beta.6\\phases\\01-runtime-contract-bootstrap\\01-CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Light identity checks every launch; bounded full smoke only on first launch, update, repair, or payload identity change to avoid unnecessary launch delay."},
    {"id": "_planning_milestones_v0_9_0_beta_6_phases_01_runtime_contract_bootstrap_01_patterns_runtime_validation", "label": "RuntimeValidator Bounded Smoke Runner", "file_type": "concept", "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\.planning\\milestones\\v0.9.0-beta.6\\phases\\01-runtime-contract-bootstrap\\01-PATTERNS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Argument-array process execution with bounded timeout, owned process-tree termination, and captured argv/exit/stdout/stderr/duration/reason evidence; never shell-concatenates Unicode paths."},
    {"id": "_planning_milestones_v0_9_0_beta_6_phases_01_runtime_contract_bootstrap_01_patterns_runtime_bootstrap_service", "label": "RuntimeBootstrapService Admission Policy", "file_type": "concept", "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\.planning\\milestones\\v0.9.0-beta.6\\phases\\01-runtime-contract-bootstrap\\01-PATTERNS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "State machine (ASSESSING/HEALTHY/SETUP_REQUIRED) composes inventory, light/full policy, migration, atomic persistence, and post-health optional resolution; never repairs or downloads."},
    {"id": "_planning_milestones_v0_9_0_beta_6_phases_01_runtime_contract_bootstrap_01_context_cpu_first_optional_fallback", "label": "CPU-First Optional Engine Fallback (D-07/D-08)", "file_type": "concept", "source_file": "C:\\Users\\marsh\\Documents\\LecturePack-worktrees\\release-polish\\.planning\\milestones\\v0.9.0-beta.6\\phases\\01-runtime-contract-bootstrap\\01-CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Healthy CUDA/custom selection is preserved while bundled CPU stays validated; a missing/broken optional engine falls back to CPU with a visible structured notice and no hard gate."},
